{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "semi": true,
    "printWidth": 120,
    "trailingComma": "none",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "useTabs": false,
    "endOfLine": "lf",
    "sortImports": true,
    "sortPackageJson": false
}
